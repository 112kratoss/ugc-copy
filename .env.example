# ============================================================
# UGC Creator — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Kie.ai — video/image generation provider
KIE_AI_API_KEY=your-kie-api-key
KIE_WEBHOOK_HMAC_KEY=your-kie-webhook-hmac-key

# Vercel Cron and protected ops dashboard authentication
CRON_SECRET=your-cron-secret
OPS_READ_SECRET=your-ops-read-secret

# Razorpay — payment gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Razorpay Webhook secret (configured in Razorpay Dashboard → Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# RevenueCat — mobile in-app purchases
REVENUECAT_SECRET_API_KEY=your-revenuecat-v1-secret-key
REVENUECAT_WEBHOOK_AUTH_TOKEN=Bearer your-revenuecat-webhook-secret

# Optional backend alert delivery — monitored destination for warning/degraded ops payloads
BACKEND_ALERT_DELIVERY_URL=https://alerts.example.com/hooks/backend
BACKEND_ALERT_DELIVERY_AUTH_HEADER=Bearer your-alert-destination-secret
# BACKEND_ALERT_DELIVERY_NOTIFY_OK=true

# Site URL — used for metadata and OAuth callbacks
NEXT_PUBLIC_SITE_URL=https://magicbooklet.com

# Optional backend budget guardrails (24h report window)
BACKEND_BUDGET_GENERATION_CREDITS_WARNING=20000
BACKEND_BUDGET_GENERATION_CREDITS_DEGRADED=50000
BACKEND_BUDGET_AI_USAGE_CREDITS_WARNING=1000
BACKEND_BUDGET_AI_USAGE_CREDITS_DEGRADED=5000
BACKEND_BUDGET_FAILED_PAID_GENERATION_CREDITS_DEGRADED=100
BACKEND_BUDGET_QUOTE_REQUESTS_WARNING=1000
BACKEND_BUDGET_QUOTE_REQUESTS_DEGRADED=5000
BACKEND_BUDGET_MEDIA_READS_WARNING=5000
BACKEND_BUDGET_MEDIA_READS_DEGRADED=20000
BACKEND_BUDGET_STORAGE_BYTES_WARNING=1073741824
BACKEND_BUDGET_STORAGE_BYTES_DEGRADED=5368709120

# Public support details (shown on /contact for payment compliance)
NEXT_PUBLIC_SUPPORT_PHONE=+91XXXXXXXXXX
NEXT_PUBLIC_BUSINESS_ADDRESS=Your registered address, City, State, PIN, India

# SEO verification and analytics
GOOGLE_SITE_VERIFICATION=your-google-site-verification-token
BING_SITE_VERIFICATION=your-bing-site-verification-token
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
