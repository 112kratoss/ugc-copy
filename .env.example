# ============================================================
# UGC Creator — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Dedicated HMAC key for the short-lived proxy-to-route identity assertion.
# Required in every deployed environment; generate at least 32 random bytes.
IDENTITY_ADMISSION_SECRET=generate-a-random-48-byte-secret-at-least-32-chars
# Local/test default. Production must set this to `database`; `code` is an
# explicit development or emergency rollback mode, never a silent fallback.
GENERATION_MODEL_CATALOG_SOURCE=code

# Kie.ai — video/image generation provider
KIE_AI_API_KEY=your-kie-api-key
KIE_WEBHOOK_HMAC_KEY=your-kie-webhook-hmac-key
KIE_PROVIDER_WEBHOOK_SECRET=your-provider-ingress-secret
# Optional HTTPS override for the provider callback URL. When unset, the
# callback defaults to NEXT_PUBLIC_SUPABASE_URL/functions/v1/kie-webhook.
# KIE_PROVIDER_CALLBACK_URL=https://your-project.supabase.co/functions/v1/kie-webhook
# Load-certification seam only. Leave unset everywhere real: when set, provider
# calls to api.kie.ai are redirected at this origin so a load test can drive
# generation without billing real generations. Ignored when VERCEL_ENV=production.
# KIE_API_BASE_URL=https://provider-stub.example
# Comma-separated HTTPS hostnames allowed for server-side provider media imports.
# Wildcards match subdomains only (for example: *.provider-cdn.example).
MEDIA_IMPORT_HOST_ALLOWLIST=your-provider-media-host.example

# Optional escape hatch for video posters and feed renditions. Leave unset:
# ffmpeg-static is resolved automatically and verified executable at runtime.
# Set it only when that resolution fails (the thrown error names what it tried),
# for example on a host whose platform ffmpeg-static does not ship a binary for.
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# Vercel Cron and protected ops dashboard authentication.
# The *_PREVIOUS variants are accepted alongside the current value so a secret
# can be rotated without a hard cutover: set the new value, deploy, move the old
# value into *_PREVIOUS, update every caller, then delete *_PREVIOUS.
CRON_SECRET=your-cron-secret
# CRON_SECRET_PREVIOUS=previous-cron-secret-during-rotation-only
OPS_READ_SECRET=your-ops-read-secret
# OPS_READ_SECRET_PREVIOUS=previous-ops-read-secret-during-rotation-only

# /admin console — single master operator. Generate every value below with
# `npm run admin:credentials`; the plaintext password is shown once and only the
# scrypt hash is stored. Admin access fails closed when any value is missing.
ADMIN_USERNAME=admin
# Dot-delimited base64url, never the conventional $-delimited MCF form: Next.js
# loads .env through dotenv-expand, which would treat `$16384` and `$<salt>` as
# variable references and silently corrupt the hash.
ADMIN_PASSWORD_HASH=scrypt.16384.8.1.generate.with-npm-run-admin-credentials
ADMIN_SESSION_SECRET=generate-a-random-48-byte-secret-at-least-32-chars
# Must be a real Supabase auth.users UUID: moderation actions write it to
# reviewed_by, which is a foreign key into auth.users.
ADMIN_REVIEWER_USER_ID=00000000-0000-0000-0000-000000000000
# Optional. Session lifetime in seconds (300–86400). Defaults to 8 hours.
# ADMIN_SESSION_TTL_SECONDS=28800
# Public recipient rendered on /child-safety. Set this to a staffed safety inbox.
# Falls back to the general support address when omitted.
CHILD_SAFETY_CONTACT_EMAIL=safety@example.com

# Razorpay — payment gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Razorpay Webhook secret (configured in Razorpay Dashboard → Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# RevenueCat — mobile in-app purchases
REVENUECAT_SECRET_API_KEY=your-revenuecat-v1-secret-key
REVENUECAT_WEBHOOK_AUTH_TOKEN=Bearer your-revenuecat-webhook-secret

# Creator payouts — at-rest encryption for payout account details
# (creator_payout_requests.payout_details). Mint with: openssl rand -base64 32
# Required in production: payout requests fail closed without it. Optional in
# local dev (details are stored plaintext with a logged warning).
CREATOR_PAYOUT_DETAILS_ENCRYPTION_KEY=base64-of-32-random-bytes

# Staging/QA only — MUST stay unset in production.
# Allows RevenueCat sandbox receipts (TestFlight, Play internal testing) to grant
# entitlements, and enables the dev-only client-declared sandbox purchase provider.
# Sandbox purchases cost nothing, so enabling this in production mints free credits.
# MOBILE_COMMERCE_ALLOW_SANDBOX=1

# Optional backend alert delivery — monitored destination for warning/degraded ops payloads
BACKEND_ALERT_DELIVERY_URL=https://alerts.example.com/hooks/backend
BACKEND_ALERT_DELIVERY_AUTH_HEADER=Bearer your-alert-destination-secret
# BACKEND_ALERT_DELIVERY_NOTIFY_OK=true

# Site URL — used for metadata and OAuth callbacks
NEXT_PUBLIC_SITE_URL=https://magicbooklet.com
# Optional override for browser OAuth/email callback generation.
# Leave unset in production unless callbacks must use a different canonical origin.
# NEXT_PUBLIC_AUTH_REDIRECT_ORIGIN=https://magicbooklet.com

# Invite & Earn attribution and verified mobile links
# Use a dedicated random secret in production; rotating it changes only risk-signal hashes.
REFERRAL_ATTRIBUTION_HASH_SECRET=replace-with-a-long-random-secret
# One-time promotion claim ledger (welcome credits): hashes sign-in identifiers so a
# deleted account cannot re-register and re-claim. Unlike the referral secret these
# digests are durable — rotating this (or running on the service-role-derived
# fallback and rotating that key) resets the ledger's memory of past claims.
ACCOUNT_IDENTITY_FINGERPRINT_SECRET=replace-with-a-long-random-secret
# Apple Developer Team ID used by /.well-known/apple-app-site-association
APPLE_TEAM_ID=XXXXXXXXXX
IOS_BUNDLE_ID=com.magicbooklet.mobile
# Server-only Sign in with Apple key used to exchange and revoke the one-time
# authorization code during account deletion. Store the .p8 value as a sensitive
# production secret; literal \n sequences are accepted for multiline values.
APPLE_SIGN_IN_KEY_ID=XXXXXXXXXX
APPLE_SIGN_IN_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_APPLE_P8_KEY\n-----END PRIVATE KEY-----
# Comma-separated SHA-256 signing certificate fingerprints used by Android App Links
ANDROID_APP_SHA256_FINGERPRINTS=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99
ANDROID_PACKAGE_NAME=com.magicbooklet.mobile
# Optional install fallbacks shown when a referral link opens without the app installed
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id0000000000
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.magicbooklet.mobile

# Google OAuth credentials for local Supabase CLI auth only.
# Production Google provider credentials are stored in Supabase Dashboard > Auth > Providers.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Optional backend budget guardrails (24h report window)
BACKEND_BUDGET_GENERATION_CREDITS_WARNING=20000
BACKEND_BUDGET_GENERATION_CREDITS_DEGRADED=50000
BACKEND_BUDGET_AI_USAGE_CREDITS_WARNING=1000
BACKEND_BUDGET_AI_USAGE_CREDITS_DEGRADED=5000
BACKEND_BUDGET_FAILED_PAID_GENERATION_CREDITS_DEGRADED=100
BACKEND_BUDGET_QUOTE_REQUESTS_WARNING=1000
BACKEND_BUDGET_QUOTE_REQUESTS_DEGRADED=5000
BACKEND_BUDGET_MEDIA_READS_WARNING=5000
BACKEND_BUDGET_MEDIA_READS_DEGRADED=20000
BACKEND_BUDGET_STORAGE_BYTES_WARNING=1073741824
BACKEND_BUDGET_STORAGE_BYTES_DEGRADED=5368709120

# Public support details (shown on /contact for payment compliance)
NEXT_PUBLIC_SUPPORT_PHONE=+91XXXXXXXXXX
NEXT_PUBLIC_BUSINESS_ADDRESS=Your registered address, City, State, PIN, India

# SEO verification and analytics
GOOGLE_SITE_VERIFICATION=your-google-site-verification-token
BING_SITE_VERIFICATION=your-bing-site-verification-token
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Dedicated random salt for pseudonymous showcase-feed identity hashes. Keep it
# stable across deploys so analytics cohorts remain consistent. When omitted,
# the server falls back to SUPABASE_SERVICE_ROLE_KEY.
# FEED_ANALYTICS_SALT=replace-with-a-long-random-secret
# Vercel Speed Insights RUM sampling ratio (greater than 0 and at most 1).
# Use the enabled flag—not a zero sample rate—to disable collection.
NEXT_PUBLIC_SPEED_INSIGHTS_ENABLED=0
NEXT_PUBLIC_SPEED_INSIGHTS_SAMPLE_RATE=1

# Performance certification harness (CLI and GitHub Actions only; these are not
# application-runtime variables and should not be added to the Vercel project).
# Signed-in certification requires all four bot values together. Use a dedicated
# non-admin test account and store these as GitHub Actions secrets.
# PERF_AUTH_SUPABASE_URL=https://your-project.supabase.co
# PERF_AUTH_SUPABASE_ANON_KEY=your-anon-key
# PERF_AUTH_BOT_EMAIL=performance-bot@example.com
# PERF_AUTH_BOT_PASSWORD=replace-with-a-dedicated-strong-password
# Local one-off alternative to the four bot values above. Supply only the bare,
# short-lived access token; never configure this in the scheduled workflow.
# PERF_AUTH_BEARER_TOKEN=eyJhbGciOi...
# Set to 1 when a run must fail instead of reporting signed-in coverage as not certified.
# PERF_REQUIRE_SIGNED_IN=1

# Optional performance target and load-shape overrides. Defaults are shown.
# PERF_BASE_URL=https://magicbooklet.com
# PERF_PROFILE=edge
# PERF_BUDGETS_PATH=config/performance-budgets.json
# PERF_DURATION_SECONDS=30
# PERF_CONCURRENCY=3
# PERF_MAX_RPS=25
# PERF_WARMUP_REQUESTS=2
# PERF_OUTPUT_PATH=performance-load-results.json
# PERF_LIGHTHOUSE_RUNS=3

# Explicit safety acknowledgements. Leave unset for ordinary local runs.
# Production load remains read-only and bounded even when enabled.
# PERF_ALLOW_PRODUCTION=1
# Origin profiling is accepted only on loopback with isolated non-production data.
# PERF_ALLOW_ORIGIN_LOAD=1
# PERF_ORIGIN_NON_PRODUCTION_DATA=1
# Raises the built-in duration/concurrency/rate caps; use only for an approved test.
# PERF_ALLOW_HIGH_LOAD=1

# Set by the gated production release workflow so smoke tests can prove that
# the promoted deployment matches the quality-verified commit.
RELEASE_GIT_SHA=

# Error tracking (F15b). Public by design — the DSN ships inside the browser
# bundle — so it is NEXT_PUBLIC_ rather than a secret. Leave unset locally and
# in CI: an absent DSN disables Sentry rather than failing the build, so a
# checkout never depends on an external account. Production is different — a
# missing value there logs a loud warning at startup, because "instrumented but
# reporting nothing" only ever surfaces during the incident it was meant to catch.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.<region>.sentry.io/<project>
