# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
performance-load-results*.json
.lighthouseci/
lighthouse-results/
/.playwright-cli
/output

# local Codex audit captures
/.codex/audits/

# local scaling-certificate evidence (may contain sensitive operational exports)
/certification-artifacts/

# next.js
/.next/
/out/

# production
/build

# local database backups
/supabase/backups

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!ugc-mobile/.env.example
# Public client values only; see the header in the file itself.
!ugc-mobile/.env.production
.mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/.codex/
