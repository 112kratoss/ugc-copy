{
  "manifestVersion": 1,
  "mode": "clone-active",
  "release": {
    "schemaVersion": 2,
    "revision": "minimax-reference-duration-20260904",
    "basedOnRevision": "video-reference-caps-20260903",
    "changeNote": "Bill minimax-h3 on input video seconds as well as output. Kie charges \"Unit Price x (Generated Video Duration + Input Video Duration)\" for minimax-h3, but our config was plain per-second on output only, so every run carrying a reference clip under-billed by the clip's length at the resolution rate - up to 15s x 13 = 195 credits, and the 2026-09-03 move to Kie's listed 8/13 removed the margin that had been absorbing it. The strategy becomes reference-adjustment with referenceDurationSlots [videoReferences] and the same 8/13 table on both sides, since Kie applies one rate either way. Caps, validation, availability, adapters and every other model are unchanged. Residual not modelled: Kie's 4 credits per input image past the first five, bounded at 16 credits by the 9-image cap.",
    "createdBy": "catalog refresh 2026-09-04 (Claude Code, operator athulsmanjeri@gmail.com)"
  },
  "upgrade": {
    "legacyDescriptorsToV2": true
  },
