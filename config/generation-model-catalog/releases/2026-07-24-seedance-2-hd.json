            "label": "Reference to video",
            "default": false,
            "conditions": [
              {
                "source": "setting",
                "key": "referenceMode",
                "operator": "equals",
                "value": "elements"
              }
            ],
            "slots": [
              {
                "key": "imageReferences",
                "kind": "image",
                "role": "reference",
                "label": "Reference images",
                "min": 0,
                "max": 5,
                "supportsNaming": true
              },
              {
                "key": "videoReferences",
                "kind": "video",
