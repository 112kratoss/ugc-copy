{
  "manifestVersion": 1,
  "mode": "clone-active",
  "release": {
    "schemaVersion": 2,
    "revision": "veo-quality-references-20261030",
    "basedOnRevision": "kie-catalog-inputs-20261029",
    "changeNote": "Veo 3.1 offers reference pictures on Lite and Fast only. Kie's REFERENCE_2_VIDEO supports veo3_fast and veo3_lite (docs/model-api-references/veo-3-1.md, re-read 2026-10-30), and the quote already refused references on Quality (\"Reusable references require Veo Lite or Fast.\"), yet the descriptor opened its references input mode on every variant. The mode now also needs mode in veo3_lite or veo3_fast, beside referenceMode elements. No price, quote rule or other input changes.",
    "createdBy": "catalog-operations"
  },
  "upgrade": {
    "legacyDescriptorsToV2": true
  },
