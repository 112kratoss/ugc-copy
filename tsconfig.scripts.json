{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "paths": {
      "@/*": ["./src/*"],
      "server-only": ["./src/__tests__/mocks/server-only.ts"]
    }
  },
  "include": [
    "scripts/**/*.ts"
  ],
  "exclude": [
    ".next",
    "node_modules",
    "src/__tests__",
    "ugc-mobile"
  ]
}
