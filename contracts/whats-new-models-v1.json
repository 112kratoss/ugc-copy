        { "id": "lumen-2", "kind": "image", "badge": "Pro", "sortOrder": 20, "displayName": "Lumen 2" },
        { "id": "aurora", "kind": "image", "badge": " new ", "sortOrder": 30, "displayName": "Aurora" },
