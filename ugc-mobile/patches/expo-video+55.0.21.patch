diff --git a/node_modules/expo-video/ios/VideoPlayerLoopController.swift b/node_modules/expo-video/ios/VideoPlayerLoopController.swift
new file mode 100644
index 0000000..6baed5e
--- /dev/null
+++ b/node_modules/expo-video/ios/VideoPlayerLoopController.swift
@@ -0,0 +1,87 @@
+import AVFoundation
+import os
+
+/// Opt-in MP4 looping. The current item keeps playing while replicas prepare
+/// behind it, so enabling the loop never replaces the visible frame or seeks.
+/// All queue mutations run on main, like Expo's item KVO observers.
+final class VideoPlayerLoopController {
+  private let player: AVQueuePlayer
+  private var looper: AVPlayerLooper?
+  private var statusObservation: NSKeyValueObservation?
+  private var preparation: Task<Void, Never>?
+  private var generation = 0
+  private static let log = OSLog(subsystem: "com.magicbooklet.media", category: .pointsOfInterest)
+
+  var isLooping: Bool { looper?.status == .ready }
+
+  func didAdvance() {
+    os_signpost(.event, log: Self.log, name: "VideoLoopAdvance")
+  }
+
+  func updateItems(_ apply: (AVPlayerItem) -> Void) {
+    player.items().forEach(apply)
+    looper?.loopingPlayerItems.forEach(apply)
+  }
+
+  init(player: AVQueuePlayer) {
+    self.player = player
+    // Match AVPlayer for non-looping sources (retain the last frame).
+    player.actionAtItemEnd = .pause
+  }
+
+  func prepare(item: AVPlayerItem) {
+    guard #available(iOS 17.0, tvOS 17.0, *) else { return }
+    guard looper == nil, preparation == nil else { return }
+    generation += 1
+    let token = generation
+    preparation = Task { @MainActor [weak self, weak item] in
+      guard let item else { return }
+      // A zero/indefinite duration is not a valid looper template. Loading off
+      // the main thread also avoids AVPlayerLooper synchronously loading it.
+      let duration = try? await item.asset.load(.duration)
+      guard !Task.isCancelled, let self, self.generation == token else { return }
+      self.preparation = nil
+      guard self.player.currentItem === item,
+        let duration, duration.isNumeric, duration.seconds > 0 else { return }
+      let looper = AVPlayerLooper(
+        player: self.player, templateItem: item, timeRange: .invalid,
+        existingItemsOrdering: .loopingItemsFollowExistingItems
+      )
+      self.looper = looper
+      self.statusObservation = looper.observe(\.status, options: [.initial, .new]) { [weak self] looper, _ in
+        guard looper.status == .failed else { return }
+        DispatchQueue.main.async { [weak self, weak looper] in
+          guard let self, let looper, self.looper === looper else { return }
+          // Restore AVPlayer semantics so Expo's existing seek loop recovers.
+          self.disable()
+        }
+      }
+      os_signpost(.event, log: Self.log, name: "VideoLoopQueueCreated")
+    }
+  }
+
+  /// Stop before source replacement or release. Do not preserve the old queue.
+  func reset() {
+    generation += 1
+    preparation?.cancel()
+    preparation = nil
+    statusObservation?.invalidate()
+    statusObservation = nil
+    looper?.disableLooping()
+    looper = nil
+    player.removeAllItems()
+    player.actionAtItemEnd = .pause
+  }
+
+  /// A caller can turn loop off while playing. Preserve the current item/time;
+  /// remove only the future replicas after the looper relinquishes the queue.
+  func disable() {
+    let current = player.currentItem
+    let rate = player.rate
+    reset()
+    if let current {
+      player.insert(current, after: nil)
+      player.rate = rate
+    }
+  }
+}
