+/**
+ * The length of the whole resource. A ranged response reports only the length
+ * of its slice in Content-Length; the total is the part after the slash in
+ * Content-Range.
+ */
+internal func totalLengthFromResponse(response: HTTPURLResponse) -> Int64 {
+  let fullString = (response.allHeaderFields["Content-Range"] ?? response.allHeaderFields["content-range"]) as? String
+  if let totalComponent = fullString?.components(separatedBy: "/")[safe: 1],
+    let total = Int64(totalComponent.trimmingCharacters(in: .whitespaces)), total > 0 {
+    return total
+  }
+  return response.expectedContentLength
+}
+
+/**
+ * Header fields that describe the whole resource. The cache replays these to
+ * the player as a synthetic 200, so a ranged response's Content-Range and
+ * partial Content-Length must not travel with them.
+ */
+internal func wholeResourceHeaderFields(response: HTTPURLResponse) -> [String: String]? {
+  guard var headers = response.allHeaderFields as? [String: String] else {
+    return nil
+  }
+  guard response.statusCode == 206 else {
+    return headers
+  }
+  for key in headers.keys where key.lowercased() == "content-range" || key.lowercased() == "content-length" {
+    headers.removeValue(forKey: key)
+  }
+  headers["Content-Length"] = String(totalLengthFromResponse(response: response))
+  return headers
+}
