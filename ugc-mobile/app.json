{
  "expo": {
    "name": "Magic Booklet",
    "slug": "magicbooklet-mobile",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "magicbooklet",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.magicbooklet.mobile",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:magicbooklet.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Magic Booklet uses your photo library so you can choose product photos, profile images, and reference images for your creations.",
        "NSPhotoLibraryAddUsageDescription": "Magic Booklet saves finished images and videos to your photo library when you choose Download or Save."
      }
    },
    "android": {
      "package": "com.magicbooklet.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#09090b"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "magicbooklet.com",
              "pathPrefix": "/r/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Magic Booklet uses your photo library so you can choose product photos, profile images, and reference images for your creations.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-video",
      "./plugins/withBuildProfileAutolinking",
      "./plugins/withAndroidLocalCleartextDebug",
      "./plugins/withAndroidReleaseOptimization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-icon.png",
          "color": "#03040d"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "80e0b101-06da-4b8c-a31f-60c90ba9bdfb"
      }
    },
    "owner": "athulsiva"
  }
}
