diff --git a/node_modules/expo-video/ios/LightVideoView.swift b/node_modules/expo-video/ios/LightVideoView.swift
new file mode 100644
index 0000000..f6408fd
--- /dev/null
+++ b/node_modules/expo-video/ios/LightVideoView.swift
@@ -0,0 +1,88 @@
+// Magicbooklet patch: a feed-weight video host for iOS.
+
+import AVFoundation
+import ExpoModulesCore
+
+/**
+ A video surface without `AVPlayerViewController`, chosen by the React wrapper for
+ `nativeControls={false}` when the binary advertises `supportsLightweightViews`.
+
+ The stock `VideoView` wraps an `AVPlayerViewController` even when its controls are
+ hidden: creating one loads the controller's whole view hierarchy on the main thread,
+ every window move starts an appearance transition, every safe-area change removes
+ and re-adds its view, and paused frames are sent for Live Text analysis. A feed
+ creates and releases these views while the reader scrolls. This host is Apple's
+ documented minimum instead: a view whose backing layer is an `AVPlayerLayer`.
+ Controls, fullscreen and Picture in Picture are not available here; screens that
+ need them keep `nativeControls` on and get the stock view.
+ */
+public final class LightVideoView: ExpoView {
+  private final class PlayerLayerView: UIView {
+    override static var layerClass: AnyClass { AVPlayerLayer.self }
+
+    var playerLayer: AVPlayerLayer {
+      // swiftlint:disable:next force_cast
+      layer as! AVPlayerLayer
+    }
+  }
+
+  private let surface = PlayerLayerView()
+  private var readyForDisplayObserver: NSKeyValueObservation?
+  private var contentOffset = CGVector.zero
+
+  let onFirstFrameRender = EventDispatcher()
+
+  weak var player: VideoPlayer? {
+    didSet {
+      surface.playerLayer.player = player?.ref
+    }
+  }
+
+  var contentFit: VideoContentFit = .contain {
+    didSet {
+      surface.playerLayer.videoGravity = contentFit.toVideoGravity()
+    }
+  }
+
+  var contentPosition: CGVector = .zero {
+    didSet {
+      contentOffset = contentPosition
+      setNeedsLayout()
+    }
+  }
+
+  public required init(appContext: AppContext? = nil) {
+    super.init(appContext: appContext)
+    clipsToBounds = true
+    surface.backgroundColor = .clear
+    surface.isUserInteractionEnabled = false
+    surface.playerLayer.videoGravity = contentFit.toVideoGravity()
+    addSubview(surface)
+
+    // Same signal as the stock view's `AVPlayerViewController.isReadyForDisplay`:
+    // the first frame of the current item can be shown.
+    readyForDisplayObserver = surface.playerLayer.observe(\.isReadyForDisplay, options: [.new]) { [weak self] layer, _ in
+      guard layer.isReadyForDisplay else {
+        return
+      }
+      if Thread.isMainThread {
+        self?.onFirstFrameRender()
+      } else {
+        DispatchQueue.main.async {
+          self?.onFirstFrameRender()
+        }
+      }
+    }
+    VideoManager.shared.register(lightVideoView: self)
+  }
+
+  deinit {
+    readyForDisplayObserver?.invalidate()
+    VideoManager.shared.unregister(lightVideoView: self)
+  }
+
+  public override func layoutSubviews() {
+    super.layoutSubviews()
+    surface.frame = bounds.offsetBy(dx: contentOffset.dx, dy: contentOffset.dy)
+  }
+}
