{
  "name": "magicbooklet-mobile",
  "version": "0.0.5",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "react-native",
        "@shopify/flash-list"
      ]
    }
  },
  "scripts": {
    "android": "expo run:android",
    "eas-build-pre-install": "node ./scripts/verify-production-build-env.mjs",
    "postinstall": "patch-package",
    "profile:android:physical": "node ./scripts/profile-android-physical.mjs",
    "release-env:self-test": "node ./scripts/verify-production-build-env.mjs --self-test",
    "start": "expo start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@shopify/flash-list": "2.3.2",
    "@supabase/supabase-js": "2.105.4",
    "@tanstack/react-query": "5.100.10",
    "expo": "~55.0.29",
    "expo-apple-authentication": "~55.0.16",
    "expo-auth-session": "~55.0.18",
    "expo-blur": "~55.0.17",
    "expo-clipboard": "~55.0.16",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.18",
    "expo-document-picker": "~55.0.16",
    "expo-file-system": "~55.0.25",
    "expo-font": "~55.0.8",
    "expo-glass-effect": "~55.0.11",
    "expo-haptics": "~55.0.17",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.23",
    "expo-linear-gradient": "~55.0.17",
    "expo-linking": "~55.0.17",
    "expo-notifications": "~55.0.26",
    "expo-observe": "~0.2.5",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.17",
    "expo-splash-screen": "~55.0.24",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.21",
    "expo-video": "~55.0.20",
    "expo-web-browser": "~55.0.19",
    "lucide-react-native": "1.14.0",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-purchases": "10.1.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "3.0.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "19.1.0",
    "babel-preset-expo": "~55.0.8",
    "expo-dev-client": "~55.0.38",
    "patch-package": "^8.0.1",
    "react-test-renderer": "^19.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.6"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "uuid": "11.1.1"
  }
}
