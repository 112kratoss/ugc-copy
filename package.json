{
  "name": "magicbooklet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "next": {
      "postcss": "^8.5.10"
    },
    "sharp": "$sharp",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "scripts": {
    "backfill:legacy-media": "node scripts/backfill-legacy-temp-media.mjs",
    "backfill:media-previews": "tsx scripts/backfill-media-previews.ts",
    "backfill:media-upload-intents": "tsx --env-file-if-exists=.env.local scripts/backfill-media-upload-intents.ts",
    "backfill:generation-video-previews": "npm run backfill:media-previews",
    "backfill:post-media-previews": "npm run backfill:media-previews",
    "backfill:showcase-assets": "node scripts/backfill-showcase-assets.mjs",
    "backfill:showcase-media-cache": "tsx --env-file-if-exists=.env.local scripts/backfill-showcase-media-cache.ts",
    "db:migrations:check": "node scripts/check-supabase-migration-drift.mjs",
    "ops:external-gates": "node scripts/production-external-gates.mjs",
    "ops:generation-model-catalog": "tsx --env-file-if-exists=.env.local scripts/generation-model-catalog.ts",
    "ops:moderation": "tsx --env-file-if-exists=.env.local scripts/moderation-ops.ts",
    "admin:credentials": "tsx scripts/admin-credentials.ts",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build",
    "build:verify": "node scripts/check-ffmpeg-build-artifact.mjs",
    "perf:load": "node scripts/performance-load-test.mjs",
    "perf:load:smoke": "node scripts/performance-load-test.mjs --smoke",
    "perf:load:self-test": "node scripts/performance-load-test.mjs --self-test",
    "perf:lighthouse": "lhci autorun --config=config/lighthouse.cjs",
    "perf:lighthouse:self-test": "node config/lighthouse.cjs",
    "postinstall": "patch-package",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json --noEmit",
    "typecheck:tests": "tsc --project tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.108.2",
    "@vercel/speed-insights": "2.0.0",
    "@xyflow/react": "^12.10.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.33.0",
    "localforage": "^1.10.0",
    "lucide-react": "^0.563.0",
    "next": "^16.2.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "sharp": "^0.35.3",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^28.1.0",
    "patch-package": "^8.0.1",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
