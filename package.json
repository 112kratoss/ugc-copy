{
  "name": "magicbooklet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "next": {
      "postcss": "^8.5.23"
    },
    "sharp": "$sharp",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "scripts": {
    "eval:enhancer": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.scripts.json scripts/ops/enhancer-eval.ts",
    "backfill:legacy-media": "node scripts/backfills/backfill-legacy-temp-media.mjs",
    "backfill:media-previews": "tsx scripts/backfills/backfill-media-previews.ts",
    "audit:media-previews": "tsx --env-file-if-exists=.env.local scripts/audits/audit-media-previews.ts",
    "backfill:profile-image-dimensions": "tsx --env-file-if-exists=.env.local scripts/backfills/backfill-profile-image-dimensions.ts",
    "backfill:media-upload-intents": "tsx --env-file-if-exists=.env.local scripts/backfills/backfill-media-upload-intents.ts",
    "backfill:welcome-credit-fingerprints": "tsx --env-file-if-exists=.env.local scripts/backfills/backfill-welcome-credit-fingerprints.ts",
    "backfill:generation-video-previews": "npm run backfill:media-previews",
    "backfill:generation-preview-dimensions": "tsx --env-file-if-exists=.env.local scripts/backfills/backfill-generation-preview-dimensions.ts",
    "backfill:media-display-renditions": "tsx --env-file-if-exists=.env.local scripts/backfills/backfill-media-display-renditions.ts",
    "backfill:generation-display-renditions": "tsx --env-file-if-exists=.env.local scripts/backfills/backfill-generation-display-renditions.ts",
    "backfill:post-media-previews": "npm run backfill:media-previews",
    "regenerate:video-posters": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.scripts.json scripts/backfills/regenerate-video-posters.ts",
    "backfill:showcase-assets": "node scripts/backfills/backfill-showcase-assets.mjs",
    "backfill:showcase-media-cache": "tsx --env-file-if-exists=.env.local scripts/backfills/backfill-showcase-media-cache.ts",
    "backfill:private-post-media": "tsx --env-file-if-exists=.env.local scripts/backfills/backfill-private-post-media.ts",
    "db:migrations:check": "node scripts/db/check-supabase-migration-drift.mjs",
    "db:inspect:performance": "node scripts/db/inspect-supabase-performance.mjs --local",
    "db:benchmark:scaling": "node scripts/db/benchmark-local-scaling.mjs",
    "ops:external-gates": "node scripts/ops/production-external-gates.mjs",
    "ops:generation-model-catalog": "tsx --env-file-if-exists=.env.local scripts/ops/generation-model-catalog.ts",
    "ops:moderation": "tsx --env-file-if-exists=.env.local scripts/ops/moderation-ops.ts",
    "admin:credentials": "tsx scripts/ops/admin-credentials.ts",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build",
    "build:verify": "node scripts/build/check-ffmpeg-build-artifact.mjs",
    "perf:load": "node scripts/perf/performance-load-test.mjs",
    "perf:load:smoke": "node scripts/perf/performance-load-test.mjs --smoke",
    "perf:load:self-test": "node scripts/perf/performance-load-test.mjs --self-test",
    "perf:lighthouse": "lhci autorun --config=config/lighthouse.cjs",
    "perf:lighthouse:self-test": "node config/lighthouse.cjs",
    "postinstall": "patch-package",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json --noEmit",
    "typecheck:tests": "tsc --project tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "ops:guest-acceptance": "bash scripts/ops/guest-checkout-acceptance.sh",
    "ops:generation-model-catalog:emit": "tsx scripts/ops/emit-generation-model-catalog-entries.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.108.2",
    "@vercel/speed-insights": "2.0.0",
    "@xyflow/react": "^12.10.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.33.0",
    "jose": "6.2.10",
    "localforage": "^1.10.0",
    "lucide-react": "^0.563.0",
    "next": "^16.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "sharp": "^0.35.3",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^28.1.0",
    "patch-package": "^8.0.1",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
